# ==============================================================================
# IntelliTrace & IntelliShop Root Docker Environment Configuration (.env.example)
# ==============================================================================

# Global Environment
NODE_ENV=production

# MongoDB Configuration
MONGODB_PORT=27017
ECOMMERCE_MONGO_URI=mongodb://mongodb:27017/ecommerce
INTELLITRACE_MONGO_URI=mongodb://mongodb:27017/intellitrace

# IntelliShop Gateway Configuration
GATEWAY_PORT=3000
SESSION_SECRET=intellishop_secure_session_secret_2026

# Internal Service URLs (Server-to-Server communication via Docker DNS)
PRODUCT_SERVICE_URL=http://product-service:3001
CART_SERVICE_URL=http://cart-service:3002
ORDER_SERVICE_URL=http://order-service:3003
PAYMENT_SERVICE_URL=http://payment-service:3004

# IntelliTrace Telemetry Configuration
INTELLITRACE_URL=http://intellitrace-backend:4000/api/v1
INTELLITRACE_API_KEY=default_telemetry_key
TELEMETRY_API_KEY=default_telemetry_key

# IntelliTrace Backend Configuration
INTELLITRACE_PORT=4000
JWT_SECRET=intellitrace_jwt_production_secret_key_2026
METRICS_POLL_INTERVAL_MS=15000

# IntelliTrace Frontend Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000/api

# Prometheus Configuration
PROMETHEUS_PORT=9090

# Distributed Tracing (Phase 10: OpenTelemetry & Jaeger)
JAEGER_UI_PORT=16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
JAEGER_URL=http://jaeger:16686

# Failure Injection Framework (Phase 11)
FAILURE_INJECTION_ENABLED=false
FAILURE_INJECTION_ENVIRONMENTS=development,test
FAILURE_INJECTION_TARGET_SERVICE=payment-service
FAILURE_INJECTION_TYPE=latency
FAILURE_INJECTION_TARGET_ROUTE=/api/payments/process
FAILURE_INJECTION_DELAY_MS=5000
FAILURE_INJECTION_PERCENTAGE=100
FAILURE_INJECTION_DURATION_SECONDS=120
