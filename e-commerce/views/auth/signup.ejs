<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow flex items-center justify-center py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg w-full bg-white p-8 rounded-2xl shadow-xl border border-gray-100">
        
        <div class="text-center mb-6">
            <div class="w-12 h-12 rounded-2xl bg-indigo-100 text-indigo-600 flex items-center justify-center mx-auto mb-3 text-xl">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-900">Create IntelliShop Account</h2>
            <p class="text-xs text-gray-500 mt-1">Join thousands of technology enthusiasts today</p>
        </div>

        <%- include('../partials/errors.ejs') %>

        <form action="/signup" method="POST" class="space-y-4">
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="firstName" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">First Name</label>
                    <input type="text" 
                           id="firstName" 
                           name="firstName" 
                           value="<%= oldInput ? oldInput.firstName : '' %>"
                           required 
                           placeholder="John" 
                           class="w-full px-3.5 py-2 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <div>
                    <label for="lastName" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Last Name</label>
                    <input type="text" 
                           id="lastName" 
                           name="lastName" 
                           value="<%= oldInput ? oldInput.lastName : '' %>"
                           placeholder="Doe" 
                           class="w-full px-3.5 py-2 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
            </div>

            <div>
                <label for="email" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Email Address</label>
                <input type="email" 
                       id="email" 
                       name="email" 
                       value="<%= oldInput ? oldInput.email : '' %>"
                       required 
                       placeholder="john@example.com" 
                       class="w-full px-3.5 py-2 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="password" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Password</label>
                    <input type="password" 
                           id="password" 
                           name="password" 
                           required 
                           placeholder="••••••••" 
                           class="w-full px-3.5 py-2 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <div>
                    <label for="confirmPassword" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Confirm Password</label>
                    <input type="password" 
                           id="confirmPassword" 
                           name="confirmPassword" 
                           required 
                           placeholder="••••••••" 
                           class="w-full px-3.5 py-2 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
            </div>

            <div>
                <label for="userType" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Account Role</label>
                <select id="userType" name="userType" class="w-full px-3.5 py-2 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                    <option value="customer" <%= oldInput && oldInput.userType === 'customer' ? 'selected' : '' %>>Customer</option>
                    <option value="admin" <%= oldInput && oldInput.userType === 'admin' ? 'selected' : '' %>>Seller / Admin</option>
                </select>
            </div>

            <div class="flex items-center pt-2">
                <input type="checkbox" id="terms" name="terms" required class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
                <label for="terms" class="ml-2 text-xs text-gray-600">I agree to the terms and conditions</label>
            </div>

            <button type="submit" 
                    class="w-full py-3 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold text-sm rounded-xl shadow-md transition transform active:scale-95">
                Register Account
            </button>
        </form>

        <div class="mt-6 pt-4 border-t border-gray-100 text-center">
            <p class="text-xs text-gray-600">
                Already have an account? 
                <a href="/login" class="text-blue-600 font-semibold hover:underline">Log in</a>
            </p>
        </div>

    </div>
</main>

</body>
</html>