<%-include('../partials/head')%>
</head>
<body class="bg-gray-100 font-sans m-0 p-0">


<%-include('../partials/nav')%>
    <!-- Main Section -->
    <main class="max-w-xl mx-auto my-8 bg-white shadow-lg rounded-lg text-center py-20 px-8">

        <h2 class="text-4xl font-bold text-gray-800 mb-8">
            Find Your Perfect Stay
        </h2>

        <a href="/host/add-home"
           class="inline-block bg-rose-500 text-white font-semibold px-6 py-3 rounded-lg hover:bg-rose-600 transition duration-300 shadow">
            Add Home
        </a>



      <!-- Registered Homes -->
<section class="max-w-xl mx-auto mt-8 bg-white shadow rounded-lg p-6">

    <h2 class="text-2xl font-bold text-rose-500 mb-4">
       hey host!! Here are our registered homes:
    </h2>

    <% if (registeredhomes.length === 0) { %>

        <p class="text-gray-500">No homes registered yet.</p>

    <% } else { %>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-10">

    <% registeredhomes.forEach(home => { %>

        <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition duration-300">

            <!-- Home Image -->
            <img
                src="/<%= home.photo %>"
                alt="<%= home.houseName %>"
                class="w-full h-56 object-cover"
            >

            <!-- Card Body -->
            <div class="p-5">

                <h2 class="text-2xl font-bold text-gray-800">
                    <%= home.houseName %>
                </h2>
            
                <p class="text-gray-500 mt-2">
                     <%= home.location %>
                </p>

                <div class="flex justify-between items-center mt-4">

                    <span class="text-yellow-500 font-semibold text-lg">
                         <%= home.rating %>
                    </span>

                    <span class="text-rose-500 font-bold text-xl">
                        ₹<%= home.price %>
                        <span class="text-sm text-gray-500 font-normal">/night</span>
                    </span>

                </div>

            <div class="mt-6 flex flex-col gap-3">
              <a href="/host/edit-home/<%= home._id %>?editing=true"
                class="w-full text-center bg-green-500 text-white py-3 rounded-lg font-semibold hover:bg-green-600 transition">
                  Edit
             </a>
             <form action="/host/delete-home/<%= home._id%>" method="POST">
             <button type="submit" 
              class="w-full bg-red-500 text-white py-3 rounded-lg font-semibold hover:bg-red-600 transition">
                   Delete
            </button>
            </form>
        </div>

            </div>

        </div>

    <% }) %>

</div>

<% } %>
</section>
    </main>
     

</body>
</html>