<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    
    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900">Your Shopping Cart</h1>
        <p class="text-xs text-gray-500 mt-1">Review your tech items before proceeding to checkout</p>
    </div>

    <% if (!cart || !cart.items || cart.items.length === 0) { %>
        <div class="bg-white p-12 text-center rounded-3xl border border-gray-200 shadow-sm space-y-4 max-w-md mx-auto my-8">
            <div class="w-20 h-20 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto text-3xl">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-900">Your Cart is Empty</h2>
            <p class="text-xs text-gray-500">Looks like you haven't added any products to your cart yet.</p>
            <a href="/products" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-6 py-3 rounded-xl shadow transition">
                Start Shopping Now
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Cart Items List -->
            <div class="lg:col-span-2 space-y-4">
                <% cart.items.forEach(function(item) { %>
                    <% if (item.productId) { %>
                        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
                            
                            <!-- Image & Details -->
                            <div class="flex items-center gap-4 w-full sm:w-auto">
                                <img src="<%= item.productId.image %>" 
                                     alt="<%= item.productId.name %>" 
                                     class="w-20 h-20 object-contain bg-gray-50 p-2 rounded-xl border border-gray-100 flex-shrink-0">
                                <div>
                                    <span class="text-[10px] font-bold text-blue-600 uppercase"><%= item.productId.category %></span>
                                    <h3 class="font-bold text-gray-900 text-sm">
                                        <a href="/products/<%= item.productId._id %>" class="hover:text-blue-600 transition"><%= item.productId.name %></a>
                                    </h3>
                                    <p class="text-xs text-gray-500 font-semibold mt-0.5">₹<%= item.price.toLocaleString('en-IN') %></p>
                                </div>
                            </div>

                            <!-- Quantity Form & Subtotal -->
                            <div class="flex items-center justify-between sm:justify-end gap-6 w-full sm:w-auto pt-3 sm:pt-0 border-t sm:border-t-0 border-gray-100">
                                <form action="/cart/update/<%= item.productId._id %>" method="POST" class="flex items-center gap-2">
                                    <select name="quantity" onchange="this.form.submit()" class="bg-gray-50 border border-gray-300 text-xs font-bold rounded-lg px-2.5 py-1.5 focus:outline-none">
                                        <% for(let i=1; i<=10; i++) { %>
                                            <option value="<%= i %>" <%= item.quantity === i ? 'selected' : '' %>><%= i %></option>
                                        <% } %>
                                    </select>
                                </form>

                                <div class="text-right">
                                    <span class="text-[10px] text-gray-400 block font-medium">Subtotal</span>
                                    <span class="text-sm font-extrabold text-gray-900">₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></span>
                                </div>

                                <!-- Remove Form -->
                                <form action="/cart/delete/<%= item.productId._id %>" method="POST">
                                    <button type="submit" class="text-gray-400 hover:text-red-600 transition p-2" title="Remove item">
                                        <i class="fa-solid fa-trash-can text-sm"></i>
                                    </button>
                                </form>
                            </div>

                        </div>
                    <% } %>
                <% }); %>
            </div>

            <!-- Order Summary Sidebar -->
            <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm h-fit space-y-6">
                <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3">Order Summary</h2>

                <div class="space-y-3 text-xs text-gray-600">
                    <div class="flex justify-between">
                        <span>Items Subtotal</span>
                        <span class="font-bold text-gray-900">₹<%= cart.totalAmount.toLocaleString('en-IN') %></span>
                    </div>
                    <div class="flex justify-between">
                        <span>Shipping Fee</span>
                        <span class="font-bold text-emerald-600">FREE</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Tax (Estimated)</span>
                        <span class="font-bold text-gray-900">Included</span>
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-100 flex justify-between items-center">
                    <span class="text-sm font-extrabold text-gray-900">Total Amount</span>
                    <span class="text-2xl font-black text-blue-600">₹<%= cart.totalAmount.toLocaleString('en-IN') %></span>
                </div>

                <a href="/checkout" class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm py-3.5 rounded-2xl text-center shadow-lg transition transform hover:-translate-y-0.5">
                    Proceed to Checkout <i class="fa-solid fa-arrow-right ml-1"></i>
                </a>
            </div>

        </div>
    <% } %>

</main>

</body>
</html>
