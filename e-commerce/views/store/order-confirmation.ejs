<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    
    <div class="bg-white rounded-3xl border border-gray-200 shadow-xl p-8 text-center space-y-6">
        
        <!-- Success Icon -->
        <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-4xl shadow-inner">
            <i class="fa-solid fa-circle-check"></i>
        </div>

        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Order Placed Successfully!</h1>
            <p class="text-xs text-gray-500 mt-1">Thank you for your purchase. We have received your order.</p>
        </div>

        <!-- Order Summary Card -->
        <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200/80 text-left space-y-4 text-xs">
            <div class="grid grid-cols-2 gap-4 pb-3 border-b border-gray-200/80">
                <div>
                    <span class="text-gray-400 block uppercase font-medium">Order Reference ID</span>
                    <span class="font-mono font-bold text-gray-900 text-sm">#<%= order._id %></span>
                </div>
                <div>
                    <span class="text-gray-400 block uppercase font-medium">Payment Status</span>
                    <span class="inline-block bg-emerald-100 text-emerald-700 font-bold px-2.5 py-0.5 rounded-full mt-0.5">
                        <%= order.paymentStatus.toUpperCase() %>
                    </span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <span class="text-gray-400 block uppercase font-medium">Total Paid</span>
                    <span class="font-extrabold text-gray-900 text-base">₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
                </div>
                <div>
                    <span class="text-gray-400 block uppercase font-medium">Estimated Delivery</span>
                    <span class="font-bold text-blue-600">3 - 5 Business Days</span>
                </div>
            </div>

            <div class="pt-3 border-t border-gray-200/80">
                <span class="text-gray-400 block uppercase font-medium mb-1">Shipping To</span>
                <p class="font-semibold text-gray-800"><%= order.shippingAddress.fullName %></p>
                <p class="text-gray-600"><%= order.shippingAddress.address %>, <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %></p>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-center pt-4">
            <a href="/orders/<%= order._id %>" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-6 py-3.5 rounded-xl shadow transition">
                View Order Details
            </a>
            <a href="/products" class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs px-6 py-3.5 rounded-xl transition">
                Continue Shopping
            </a>
        </div>

    </div>

</main>

</body>
</html>
