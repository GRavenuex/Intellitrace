<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div class="space-y-6 text-center md:text-left z-10">
                <span class="bg-blue-500/20 text-blue-300 border border-blue-500/30 text-xs font-semibold px-3 py-1.5 rounded-full uppercase tracking-wider">
                    ⚡ Next-Gen Tech Store
                </span>
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
                    Upgrade Your <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-300">Technology</span>
                </h1>
                <p class="text-lg text-gray-300 max-w-xl">
                    Discover premium laptops, flagship smartphones, studio headphones, and high-performance mechanical keyboards at unbeatable prices.
                </p>
                <div class="flex flex-wrap gap-4 justify-center md:justify-start pt-2">
                    <a href="/products" 
                       class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-8 py-3.5 rounded-xl shadow-lg hover:shadow-blue-500/30 transition transform hover:-translate-y-0.5">
                        Shop Now <i class="fa-solid fa-arrow-right ml-2 text-sm"></i>
                    </a>
                    <a href="#categories" 
                       class="bg-slate-800 hover:bg-slate-700 text-gray-200 font-semibold px-6 py-3.5 rounded-xl border border-slate-700 transition">
                        Explore Categories
                    </a>
                </div>
            </div>

            <!-- Hero Image Banner -->
            <div class="relative flex justify-center z-10">
                <div class="w-full max-w-lg bg-gradient-to-tr from-blue-600/20 to-indigo-500/20 p-4 rounded-3xl backdrop-blur-sm border border-white/10 shadow-2xl">
                    <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=800&auto=format&fit=crop&q=80" 
                         alt="MacBook Air M3 Hero" 
                         class="rounded-2xl object-cover shadow-lg w-full h-80">
                </div>
            </div>
        </div>
    </section>

    <!-- Categories Section -->
    <section id="categories" class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <h2 class="text-3xl font-extrabold text-gray-900">Featured Categories</h2>
            <p class="text-sm text-gray-500 mt-2">Browse top rated equipment engineered for productivity and gaming</p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-4">
            <% categories.forEach(function(cat) { %>
                <a href="/products?category=<%= cat %>" 
                   class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:border-blue-200 transition text-center flex flex-col items-center group">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-3 text-lg group-hover:scale-110 group-hover:bg-blue-600 group-hover:text-white transition-all">
                        <% if (cat === 'Laptops') { %><i class="fa-solid fa-laptop"></i><% } %>
                        <% if (cat === 'Smartphones') { %><i class="fa-solid fa-mobile-screen-button"></i><% } %>
                        <% if (cat === 'Headphones') { %><i class="fa-solid fa-headphones"></i><% } %>
                        <% if (cat === 'Keyboards') { %><i class="fa-solid fa-keyboard"></i><% } %>
                        <% if (cat === 'Mice') { %><i class="fa-solid fa-mouse"></i><% } %>
                        <% if (cat === 'Monitors') { %><i class="fa-solid fa-desktop"></i><% } %>
                        <% if (cat === 'Accessories') { %><i class="fa-solid fa-plug"></i><% } %>
                    </div>
                    <span class="text-xs font-bold text-gray-800 group-hover:text-blue-600 transition"><%= cat %></span>
                </a>
            <% }); %>
        </div>
    </section>

    <!-- Featured Products Section -->
    <section class="bg-gray-100/60 py-16 px-4 sm:px-6 lg:px-8 border-t border-gray-200/60">
        <div class="max-w-7xl mx-auto">
            <div class="flex justify-between items-end mb-10">
                <div>
                    <h2 class="text-3xl font-extrabold text-gray-900">Featured Technology</h2>
                    <p class="text-sm text-gray-500 mt-1">Handpicked top performers with highest customer satisfaction</p>
                </div>
                <a href="/products" class="text-blue-600 font-bold text-sm hover:underline flex items-center gap-1">
                    View All Products <i class="fa-solid fa-chevron-right text-xs"></i>
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <% featuredProducts.forEach(function(product) { %>
                    <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm overflow-hidden flex flex-col hover:shadow-xl transition-all duration-300 group">
                        <div class="relative bg-gray-50 p-4 flex items-center justify-center h-48 overflow-hidden">
                            <img src="<%= product.image %>" 
                                 alt="<%= product.name %>" 
                                 class="max-h-full object-contain group-hover:scale-105 transition-transform duration-300">
                            <span class="absolute top-3 right-3 bg-slate-900/80 text-amber-400 text-xs font-bold px-2.5 py-1 rounded-full flex items-center gap-1 backdrop-blur-sm">
                                <i class="fa-solid fa-star text-[10px]"></i> <%= product.rating %>
                            </span>
                        </div>
                        <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
                            <div>
                                <span class="text-[11px] font-semibold text-blue-600 uppercase tracking-wider"><%= product.category %></span>
                                <h3 class="font-bold text-gray-900 text-base line-clamp-1 mt-0.5 group-hover:text-blue-600 transition">
                                    <a href="/products/<%= product._id %>"><%= product.name %></a>
                                </h3>
                                <p class="text-xs text-gray-500 line-clamp-2 mt-1"><%= product.description %></p>
                            </div>
                            <div class="pt-3 border-t border-gray-100 flex items-center justify-between">
                                <div>
                                    <span class="text-xs text-gray-400 block">Price</span>
                                    <span class="text-lg font-extrabold text-gray-900">₹<%= product.price.toLocaleString('en-IN') %></span>
                                </div>
                                <a href="/products/<%= product._id %>" 
                                   class="bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white p-2.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
                                    Details <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

</main>

<footer class="bg-slate-900 text-gray-400 py-12 px-4 border-t border-slate-800 mt-auto">
    <div class="max-w-7xl mx-auto text-center space-y-4">
        <div class="flex items-center justify-center gap-2 text-white text-xl font-bold">
            <i class="fa-solid fa-microchip text-blue-500"></i> IntelliShop
        </div>
        <p class="text-xs text-gray-500 max-w-md mx-auto">
            Monolithic E-Commerce Test Environment for IntelliTrace Root Cause Analysis.
        </p>
        <p class="text-xs text-gray-600">&copy; <%= new Date().getFullYear() %> IntelliShop. All rights reserved.</p>
    </div>
</footer>

</body>
</html>
