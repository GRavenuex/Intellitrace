<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    
    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900">User Management</h1>
        <p class="text-xs text-gray-500 mt-1">View registered accounts and assigned user roles</p>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-gray-200 mb-8 gap-6 text-sm font-bold">
        <a href="/host/dashboard" class="pb-3 text-gray-500 hover:text-gray-900">Overview</a>
        <a href="/host/products" class="pb-3 text-gray-500 hover:text-gray-900">Products Inventory</a>
        <a href="/host/orders" class="pb-3 text-gray-500 hover:text-gray-900">Orders</a>
        <a href="/host/users" class="pb-3 text-blue-600 border-b-2 border-blue-600">Users</a>
    </div>

    <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden p-6">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-gray-600">
                <thead class="bg-gray-50 uppercase text-[10px] font-bold text-gray-400 border-y border-gray-100">
                    <tr>
                        <th class="py-3 px-4">User ID</th>
                        <th class="py-3 px-4">Name</th>
                        <th class="py-3 px-4">Email</th>
                        <th class="py-3 px-4">Role</th>
                        <th class="py-3 px-4">Registered Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 font-medium">
                    <% users.forEach(function(u) { %>
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-3 px-4 font-mono font-bold text-gray-900">#<%= u._id %></td>
                            <td class="py-3 px-4 font-bold text-gray-900"><%= u.firstName %> <%= u.lastName %></td>
                            <td class="py-3 px-4 text-blue-600 font-semibold"><%= u.email %></td>
                            <td class="py-3 px-4">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold <%= (u.userType === 'admin' || u.userType === 'host') ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800' %>">
                                    <%= u.userType.toUpperCase() %>
                                </span>
                            </td>
                            <td class="py-3 px-4 text-gray-400"><%= new Date(u.createdAt).toLocaleDateString() %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

</main>

</body>
</html>
