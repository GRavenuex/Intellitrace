<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    
    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900">Order Management</h1>
        <p class="text-xs text-gray-500 mt-1">Review orders and update fulfillment status</p>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-gray-200 mb-8 gap-6 text-sm font-bold">
        <a href="/host/dashboard" class="pb-3 text-gray-500 hover:text-gray-900">Overview</a>
        <a href="/host/products" class="pb-3 text-gray-500 hover:text-gray-900">Products Inventory</a>
        <a href="/host/orders" class="pb-3 text-blue-600 border-b-2 border-blue-600">Orders</a>
        <a href="/host/users" class="pb-3 text-gray-500 hover:text-gray-900">Users</a>
    </div>

    <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden p-6">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-gray-600">
                <thead class="bg-gray-50 uppercase text-[10px] font-bold text-gray-400 border-y border-gray-100">
                    <tr>
                        <th class="py-3 px-4">Order ID</th>
                        <th class="py-3 px-4">Customer Email</th>
                        <th class="py-3 px-4">Items Count</th>
                        <th class="py-3 px-4">Total Amount</th>
                        <th class="py-3 px-4">Payment</th>
                        <th class="py-3 px-4">Order Status</th>
                        <th class="py-3 px-4">Update Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 font-medium">
                    <% orders.forEach(function(order) { %>
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-3 px-4 font-mono font-bold text-gray-900">#<%= order._id.toString().slice(-6) %></td>
                            <td class="py-3 px-4 font-semibold text-gray-800"><%= order.userId ? order.userId.email : 'Unknown' %></td>
                            <td class="py-3 px-4"><%= order.items.length %> items</td>
                            <td class="py-3 px-4 font-extrabold text-gray-900">₹<%= order.totalAmount.toLocaleString('en-IN') %></td>
                            <td class="py-3 px-4">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold <%= order.paymentStatus === 'success' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                                    <%= order.paymentStatus %>
                                </span>
                            </td>
                            <td class="py-3 px-4 font-bold text-blue-600"><%= order.orderStatus.toUpperCase() %></td>
                            <td class="py-3 px-4">
                                <form action="/host/orders/update-status" method="POST" class="flex items-center gap-2">
                                    <input type="hidden" name="orderId" value="<%= order._id %>">
                                    <select name="orderStatus" onchange="this.form.submit()" class="bg-gray-50 border border-gray-300 text-xs font-semibold rounded-lg px-2 py-1 focus:outline-none">
                                        <option value="pending" <%= order.orderStatus === 'pending' ? 'selected' : '' %>>Pending</option>
                                        <option value="confirmed" <%= order.orderStatus === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                                        <option value="processing" <%= order.orderStatus === 'processing' ? 'selected' : '' %>>Processing</option>
                                        <option value="shipped" <%= order.orderStatus === 'shipped' ? 'selected' : '' %>>Shipped</option>
                                        <option value="delivered" <%= order.orderStatus === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                        <option value="cancelled" <%= order.orderStatus === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                    </select>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

</main>

</body>
</html>
