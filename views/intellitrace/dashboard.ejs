<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/intellitrace.css">
    <!-- Using Google Fonts for professional typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="dark-theme">
    <nav class="top-nav">
        <div class="nav-brand">
            <span class="logo">INTELLITRACE</span>
            <span class="subtitle">Application Observability & Monitoring</span>
        </div>
        <div class="nav-status">
            <div id="global-status-indicator" class="status-indicator healthy">
                <span class="dot"></span> <span id="global-status-text">System Healthy</span>
            </div>
            <div class="last-updated">
                Last updated: <span id="last-updated-time">--:--:--</span>
            </div>
            <a href="/" class="back-link">Back to Shop</a>
        </div>
    </nav>

    <main class="dashboard-container">
        <!-- Overview Cards -->
        <section class="section-overview">
            <div class="card stat-card">
                <h3>Total Requests</h3>
                <div class="stat-value" id="stat-total-requests">0</div>
            </div>
            <div class="card stat-card">
                <h3>Avg Response</h3>
                <div class="stat-value" id="stat-avg-response">0 ms</div>
            </div>
            <div class="card stat-card">
                <h3>Error Rate</h3>
                <div class="stat-value" id="stat-error-rate">0.00%</div>
            </div>
            <div class="card stat-card">
                <h3>Uptime</h3>
                <div class="stat-value" id="stat-uptime">0s</div>
            </div>
        </section>

        <div class="main-grid">
            <!-- Left Column -->
            <div class="col-left">
                <!-- Service / Component Health -->
                <section class="card">
                    <div class="card-header">
                        <h2>Services / Components</h2>
                    </div>
                    <div class="card-body">
                        <table class="data-table" id="components-table">
                            <thead>
                                <tr>
                                    <th>Component</th>
                                    <th>Status</th>
                                    <th>Avg Response</th>
                                    <th>Error Rate</th>
                                    <th>Requests</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- Database Performance -->
                <section class="card">
                    <div class="card-header">
                        <h2>Database Performance</h2>
                    </div>
                    <div class="card-body db-stats-grid">
                        <div class="db-stat">
                            <span class="db-label">Operations</span>
                            <span class="db-value" id="db-total-ops">0</span>
                        </div>
                        <div class="db-stat text-success">
                            <span class="db-label">Success</span>
                            <span class="db-value" id="db-success-ops">0</span>
                        </div>
                        <div class="db-stat text-danger">
                            <span class="db-label">Failed</span>
                            <span class="db-value" id="db-failed-ops">0</span>
                        </div>
                        <div class="db-stat">
                            <span class="db-label">Avg Duration</span>
                            <span class="db-value" id="db-avg-duration">0 ms</span>
                        </div>
                        <div class="db-stat">
                            <span class="db-label">Min</span>
                            <span class="db-value" id="db-min-duration">0 ms</span>
                        </div>
                        <div class="db-stat">
                            <span class="db-label">Max</span>
                            <span class="db-value" id="db-max-duration">0 ms</span>
                        </div>
                    </div>
                </section>
                
                <!-- Endpoint Performance -->
                <section class="card">
                    <div class="card-header">
                        <h2>Endpoint Performance</h2>
                    </div>
                    <div class="card-body">
                        <table class="data-table" id="endpoints-table">
                            <thead>
                                <tr>
                                    <th>Endpoint</th>
                                    <th>Requests</th>
                                    <th>Errors</th>
                                    <th>Avg</th>
                                    <th>Min</th>
                                    <th>Max</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            <!-- Right Column -->
            <div class="col-right">
                <!-- Response Time Chart (Visual) -->
                <section class="card">
                    <div class="card-header">
                        <h2>Response Time</h2>
                    </div>
                    <div class="card-body">
                        <div class="response-metrics">
                            <div class="rm-item">
                                <span class="rm-label">Average</span>
                                <span class="rm-value" id="rm-avg">0 ms</span>
                            </div>
                            <div class="rm-item">
                                <span class="rm-label">Minimum</span>
                                <span class="rm-value" id="rm-min">0 ms</span>
                            </div>
                            <div class="rm-item">
                                <span class="rm-label">Maximum</span>
                                <span class="rm-value" id="rm-max">0 ms</span>
                            </div>
                        </div>
                        <div class="chart-container" id="response-chart-container">
                            <!-- Simple HTML/CSS Bar visualization -->
                            <div class="bars-wrapper" id="response-bars">
                                <!-- Bars generated by JS -->
                            </div>
                        </div>
                    </div>
                </section>

                <!-- HTTP Status Distribution -->
                <section class="card">
                    <div class="card-header">
                        <h2>HTTP Status Distribution</h2>
                    </div>
                    <div class="card-body">
                        <div class="status-dist">
                            <div class="status-item status-2xx">
                                <div class="status-name">2xx Success</div>
                                <div class="status-bar-bg"><div class="status-bar-fill" id="bar-2xx" style="width:0%"></div></div>
                                <div class="status-stats">
                                    <span id="count-2xx">0</span> (<span id="pct-2xx">0%</span>)
                                </div>
                            </div>
                            <div class="status-item status-3xx">
                                <div class="status-name">3xx Redirection</div>
                                <div class="status-bar-bg"><div class="status-bar-fill" id="bar-3xx" style="width:0%"></div></div>
                                <div class="status-stats">
                                    <span id="count-3xx">0</span> (<span id="pct-3xx">0%</span>)
                                </div>
                            </div>
                            <div class="status-item status-4xx">
                                <div class="status-name">4xx Client Error</div>
                                <div class="status-bar-bg"><div class="status-bar-fill" id="bar-4xx" style="width:0%"></div></div>
                                <div class="status-stats">
                                    <span id="count-4xx">0</span> (<span id="pct-4xx">0%</span>)
                                </div>
                            </div>
                            <div class="status-item status-5xx">
                                <div class="status-name">5xx Server Error</div>
                                <div class="status-bar-bg"><div class="status-bar-fill" id="bar-5xx" style="width:0%"></div></div>
                                <div class="status-stats">
                                    <span id="count-5xx">0</span> (<span id="pct-5xx">0%</span>)
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Active Incidents -->
                <section class="card">
                    <div class="card-header">
                        <h2>Active Incidents</h2>
                    </div>
                    <div class="card-body" id="incidents-container">
                        <div class="no-incidents">✓ No active incidents</div>
                        <!-- Incidents populated by JS -->
                    </div>
                </section>
            </div>
        </div>
    </main>

    <!-- Client-side logic for the dashboard -->
    <script src="/js/intellitrace.js"></script>
</body>
</html>
