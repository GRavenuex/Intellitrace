<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/intellitrace.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="dark-theme">
    <nav class="top-nav">
        <div class="nav-brand">
            <span class="logo">INTELLITRACE</span>
            <span class="subtitle">Incident Investigation</span>
        </div>
        <div class="nav-status">
            <a href="/intellitrace" class="back-link">Back to Dashboard</a>
        </div>
    </nav>

    <main class="dashboard-container">
        <section class="card incident-card">
            <div class="card-header incident-header">
                <h2>INCIDENT</h2>
                <span class="incident-id">ID: <%= incidentId %></span>
            </div>
            <div class="card-body">
                <div id="incident-detail-content">
                    Loading incident details...
                </div>
            </div>
        </section>
    </main>

    <script>
        // In a real system, we'd fetch this from the backend. 
        // For Phase 4, we generate it based on URL or local storage, or pass from backend.
        // Let's retrieve from localStorage as a simple mechanism for this phase.
        document.addEventListener('DOMContentLoaded', () => {
            const incidentId = '<%= incidentId %>';
            const storedIncidents = JSON.parse(localStorage.getItem('intellitrace_incidents') || '[]');
            const incident = storedIncidents.find(i => i.id === incidentId);
            
            const contentDiv = document.getElementById('incident-detail-content');
            
            if (!incident) {
                contentDiv.innerHTML = '<div class="no-incidents">Incident not found or has been resolved.</div>';
                return;
            }

            const severityClass = incident.severity === 'CRITICAL' ? 'text-danger' : 
                                 (incident.severity === 'WARNING' ? 'text-warning' : 'text-success');

            contentDiv.innerHTML = `
                <div class="incident-detail-grid">
                    <div class="id-row">
                        <span class="id-label">Title</span>
                        <h3 class="id-value">${incident.title}</h3>
                    </div>
                    <div class="id-row">
                        <span class="id-label">Severity</span>
                        <span class="id-value severity-badge ${severityClass}">${incident.severity}</span>
                    </div>
                    <div class="id-row">
                        <span class="id-label">Detected At</span>
                        <span class="id-value">${new Date(incident.timestamp).toLocaleString()}</span>
                    </div>
                    <div class="id-row">
                        <span class="id-label">Affected Component/Endpoint</span>
                        <span class="id-value">${incident.endpoint || incident.component || 'N/A'}</span>
                    </div>
                    <div class="id-row">
                        <span class="id-label">Current Value</span>
                        <span class="id-value">${incident.value}</span>
                    </div>
                    <div class="id-row">
                        <span class="id-label">Description</span>
                        <span class="id-value">${incident.description}</span>
                    </div>
                </div>
                <div class="incident-actions">
                    <button class="btn btn-primary" onclick="alert('RCA Engine will be available in the next phase.')">Run AI Root Cause Analysis</button>
                </div>
            `;
        });
    </script>
</body>
</html>
