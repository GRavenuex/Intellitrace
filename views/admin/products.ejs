<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Products Inventory</h1>
            <p class="text-xs text-gray-500 mt-1">Manage, update, and remove electronics catalog products</p>
        </div>

        <a href="/host/add-product" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow transition flex items-center gap-1.5">
            <i class="fa-solid fa-plus"></i> Add Product
        </a>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-gray-200 mb-8 gap-6 text-sm font-bold">
        <a href="/host/dashboard" class="pb-3 text-gray-500 hover:text-gray-900">Overview</a>
        <a href="/host/products" class="pb-3 text-blue-600 border-b-2 border-blue-600">Products Inventory</a>
        <a href="/host/orders" class="pb-3 text-gray-500 hover:text-gray-900">Orders</a>
        <a href="/host/users" class="pb-3 text-gray-500 hover:text-gray-900">Users</a>
    </div>

    <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden p-6">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-gray-600">
                <thead class="bg-gray-50 uppercase text-[10px] font-bold text-gray-400 border-y border-gray-100">
                    <tr>
                        <th class="py-3 px-4">Product</th>
                        <th class="py-3 px-4">Category</th>
                        <th class="py-3 px-4">Brand</th>
                        <th class="py-3 px-4">Price</th>
                        <th class="py-3 px-4">Stock</th>
                        <th class="py-3 px-4">Rating</th>
                        <th class="py-3 px-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 font-medium">
                    <% products.forEach(function(product) { %>
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-3 px-4 flex items-center gap-3">
                                <img src="<%= product.image %>" class="w-10 h-10 object-contain bg-gray-50 p-1 rounded-lg border border-gray-100">
                                <div>
                                    <span class="font-bold text-gray-900 text-xs block line-clamp-1"><%= product.name %></span>
                                    <span class="text-[10px] text-gray-400 font-mono">ID: <%= product._id.toString().slice(-6) %></span>
                                </div>
                            </td>
                            <td class="py-3 px-4"><span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded-md font-semibold"><%= product.category %></span></td>
                            <td class="py-3 px-4 font-semibold text-gray-700"><%= product.brand %></td>
                            <td class="py-3 px-4 font-extrabold text-gray-900">₹<%= product.price.toLocaleString('en-IN') %></td>
                            <td class="py-3 px-4">
                                <span class="font-bold <%= product.stock > 5 ? 'text-emerald-600' : 'text-red-600' %>">
                                    <%= product.stock %> units
                                </span>
                            </td>
                            <td class="py-3 px-4 font-bold text-amber-500"><i class="fa-solid fa-star text-[10px]"></i> <%= product.rating %></td>
                            <td class="py-3 px-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/host/edit-product/<%= product._id %>" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-semibold px-3 py-1.5 rounded-lg transition">
                                        Edit
                                    </a>
                                    <form action="/host/delete-product/<%= product._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                        <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 text-xs font-semibold px-3 py-1.5 rounded-lg transition">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

</main>

</body>
</html>
