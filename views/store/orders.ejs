<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    
    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900">Order History</h1>
        <p class="text-xs text-gray-500 mt-1">Track and manage your recent tech purchases</p>
    </div>

    <% if (!orders || orders.length === 0) { %>
        <div class="bg-white p-12 text-center rounded-3xl border border-gray-200 shadow-sm space-y-4 max-w-md mx-auto my-8">
            <div class="w-20 h-20 bg-gray-100 text-gray-400 rounded-full flex items-center justify-center mx-auto text-3xl">
                <i class="fa-solid fa-box-open"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-900">No Orders Placed Yet</h2>
            <p class="text-xs text-gray-500">You haven't placed any orders with IntelliShop yet.</p>
            <a href="/products" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-6 py-3 rounded-xl shadow transition">
                Browse Tech Products
            </a>
        </div>
    <% } else { %>
        <div class="space-y-6">
            <% orders.forEach(function(order) { %>
                <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden p-6 hover:shadow-md transition">
                    
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-4 border-b border-gray-100 gap-4">
                        <div>
                            <span class="text-[10px] text-gray-400 block font-medium uppercase">Order ID</span>
                            <span class="font-mono font-bold text-gray-900 text-sm">#<%= order._id %></span>
                            <span class="text-xs text-gray-400 block mt-0.5"><%= new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                        </div>

                        <div class="flex items-center gap-3">
                            <span class="px-3 py-1 rounded-full text-xs font-bold <%= order.paymentStatus === 'success' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                                Payment: <%= order.paymentStatus.toUpperCase() %>
                            </span>
                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                                Status: <%= order.orderStatus.toUpperCase() %>
                            </span>
                        </div>
                    </div>

                    <!-- Items Preview -->
                    <div class="py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                        <div class="flex items-center gap-3 overflow-x-auto">
                            <% order.items.slice(0, 3).forEach(function(item) { %>
                                <div class="flex items-center gap-2 bg-gray-50 p-2 rounded-xl border border-gray-100">
                                    <img src="<%= item.image %>" class="w-10 h-10 object-contain">
                                    <div class="text-xs">
                                        <span class="font-bold text-gray-800 line-clamp-1"><%= item.name %></span>
                                        <span class="text-gray-400">Qty: <%= item.quantity %></span>
                                    </div>
                                </div>
                            <% }); %>
                            <% if (order.items.length > 3) { %>
                                <span class="text-xs font-bold text-gray-400 bg-gray-100 px-3 py-2 rounded-xl">+<%= order.items.length - 3 %> more</span>
                            <% } %>
                        </div>

                        <div class="text-right w-full sm:w-auto">
                            <span class="text-[10px] text-gray-400 block font-medium">Total Amount</span>
                            <span class="text-lg font-black text-gray-900">₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-gray-100 flex justify-end">
                        <a href="/orders/<%= order._id %>" class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs px-4 py-2 rounded-xl transition flex items-center gap-1.5">
                            View Order Details <i class="fa-solid fa-chevron-right text-[10px]"></i>
                        </a>
                    </div>

                </div>
            <% }); %>
        </div>
    <% } %>

</main>

</body>
</html>
