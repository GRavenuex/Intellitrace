<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    
    <!-- Breadcrumb -->
    <nav class="flex text-xs text-gray-500 mb-6 gap-2">
        <a href="/" class="hover:text-blue-600">Home</a>
        <span>/</span>
        <a href="/products" class="hover:text-blue-600">Products</a>
        <span>/</span>
        <a href="/products?category=<%= product.category %>" class="hover:text-blue-600"><%= product.category %></a>
        <span>/</span>
        <span class="text-gray-800 font-semibold"><%= product.name %></span>
    </nav>

    <!-- Main Detail Grid -->
    <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-2 gap-10">
        
        <!-- Large Product Image -->
        <div class="bg-gray-50 rounded-2xl p-8 flex items-center justify-center border border-gray-100 min-h-[350px]">
            <img src="<%= product.image %>" 
                 alt="<%= product.name %>" 
                 class="max-h-96 object-contain rounded-xl shadow-sm hover:scale-105 transition-transform duration-300">
        </div>

        <!-- Product Specs & Action Form -->
        <div class="space-y-6 flex flex-col justify-between">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span class="bg-blue-100 text-blue-700 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                        <%= product.category %>
                    </span>
                    <span class="text-xs font-semibold text-gray-400">Brand: <strong class="text-gray-700"><%= product.brand %></strong></span>
                </div>

                <h1 class="text-3xl font-extrabold text-gray-900"><%= product.name %></h1>

                <!-- Rating & Stock -->
                <div class="flex items-center gap-4 text-xs">
                    <div class="flex items-center gap-1 text-amber-500 font-bold bg-amber-50 px-2.5 py-1 rounded-lg border border-amber-200">
                        <i class="fa-solid fa-star"></i> <%= product.rating %> / 5.0
                    </div>
                    
                    <% if (product.stock > 0) { %>
                        <span class="text-emerald-600 font-bold flex items-center gap-1">
                            <i class="fa-solid fa-circle-check"></i> In Stock (<%= product.stock %> units available)
                        </span>
                    <% } else { %>
                        <span class="text-red-600 font-bold flex items-center gap-1">
                            <i class="fa-solid fa-circle-xmark"></i> Out of Stock
                        </span>
                    <% } %>
                </div>

                <!-- Price -->
                <div class="py-3 border-y border-gray-100">
                    <span class="text-xs text-gray-400 block font-medium uppercase tracking-wider">Price</span>
                    <span class="text-3xl font-black text-gray-900">₹<%= product.price.toLocaleString('en-IN') %></span>
                    <span class="text-xs text-gray-500 block mt-0.5">Inclusive of all taxes</span>
                </div>

                <!-- Description -->
                <div>
                    <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-2">Description</h3>
                    <p class="text-sm text-gray-600 leading-relaxed"><%= product.description %></p>
                </div>
            </div>

            <!-- Add to Cart & Buy Now Form -->
            <form action="/cart/add" method="POST" class="pt-6 border-t border-gray-100 space-y-4">
                <input type="hidden" name="productId" value="<%= product._id %>">
                
                <div class="flex items-center gap-4">
                    <label for="quantity" class="text-xs font-bold text-gray-700 uppercase tracking-wider">Quantity:</label>
                    <select name="quantity" id="quantity" class="bg-gray-50 border border-gray-300 rounded-xl px-4 py-2 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <% for(let i=1; i<=Math.min(product.stock, 10); i++) { %>
                            <option value="<%= i %>"><%= i %></option>
                        <% } %>
                    </select>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                    <button type="submit" 
                            <%= product.stock === 0 ? 'disabled' : '' %>
                            class="w-full bg-blue-600 hover:bg-blue-700 disabled:bg-gray-300 text-white font-bold py-3.5 px-6 rounded-2xl shadow-lg hover:shadow-blue-500/20 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-cart-plus"></i> Add to Cart
                    </button>
                    
                    <button type="submit" 
                            <%= product.stock === 0 ? 'disabled' : '' %>
                            class="w-full bg-slate-900 hover:bg-slate-800 disabled:bg-gray-300 text-white font-bold py-3.5 px-6 rounded-2xl shadow-md transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-bolt text-amber-400"></i> Buy Now
                    </button>
                </div>
            </form>
        </div>

    </div>

    <!-- Related Products -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
        <section class="mt-16">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Similar Tech Products</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
                <% relatedProducts.forEach(function(rel) { %>
                    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-sm flex flex-col justify-between hover:shadow-md transition">
                        <div>
                            <img src="<%= rel.image %>" alt="<%= rel.name %>" class="h-36 object-contain mx-auto mb-3">
                            <h4 class="font-bold text-sm text-gray-900 line-clamp-1"><%= rel.name %></h4>
                            <p class="text-xs text-gray-500 mt-1 font-extrabold text-blue-600">₹<%= rel.price.toLocaleString('en-IN') %></p>
                        </div>
                        <a href="/products/<%= rel._id %>" class="mt-3 block text-center text-xs font-bold py-2 bg-gray-100 hover:bg-gray-200 rounded-xl transition">View</a>
                    </div>
                <% }); %>
            </div>
        </section>
    <% } %>

</main>

</body>
</html>
