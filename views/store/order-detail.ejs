<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    
    <!-- Breadcrumb -->
    <nav class="flex text-xs text-gray-500 mb-6 gap-2">
        <a href="/" class="hover:text-blue-600">Home</a>
        <span>/</span>
        <a href="/orders" class="hover:text-blue-600">My Orders</a>
        <span>/</span>
        <span class="text-gray-800 font-semibold">#<%= order._id %></span>
    </nav>

    <div class="bg-white rounded-3xl border border-gray-200 shadow-xl p-6 sm:p-8 space-y-8">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-gray-100 gap-4">
            <div>
                <span class="text-xs font-bold text-blue-600 uppercase tracking-wider">Order Specifications</span>
                <h1 class="text-2xl font-extrabold text-gray-900 mt-1">Order #<%= order._id %></h1>
                <p class="text-xs text-gray-400 mt-0.5">Placed on <%= new Date(order.createdAt).toLocaleString() %></p>
            </div>

            <div class="flex items-center gap-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold <%= order.paymentStatus === 'success' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                    Payment: <%= order.paymentStatus.toUpperCase() %>
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                    Order Status: <%= order.orderStatus.toUpperCase() %>
                </span>
            </div>
        </div>

        <!-- Items Table -->
        <div>
            <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4">Purchased Items</h2>
            <div class="space-y-3">
                <% order.items.forEach(function(item) { %>
                    <div class="flex items-center justify-between p-4 rounded-2xl bg-gray-50 border border-gray-100 text-xs">
                        <div class="flex items-center gap-4">
                            <img src="<%= item.image %>" class="w-14 h-14 object-contain bg-white p-2 rounded-xl border border-gray-200">
                            <div>
                                <h3 class="font-bold text-gray-900 text-sm"><%= item.name %></h3>
                                <p class="text-gray-500">Unit Price: ₹<%= item.price.toLocaleString('en-IN') %></p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-gray-500 block">Quantity: <%= item.quantity %></span>
                            <span class="font-extrabold text-gray-900 text-sm">₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></span>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- Shipping & Summary Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-gray-100 text-xs">
            <div class="bg-gray-50 p-5 rounded-2xl border border-gray-100 space-y-2">
                <h3 class="font-bold text-gray-900 uppercase tracking-wider mb-2">Shipping Information</h3>
                <p><span class="font-semibold text-gray-700">Name:</span> <%= order.shippingAddress.fullName %></p>
                <p><span class="font-semibold text-gray-700">Phone:</span> <%= order.shippingAddress.phone %></p>
                <p><span class="font-semibold text-gray-700">Address:</span> <%= order.shippingAddress.address %>, <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %></p>
            </div>

            <div class="bg-gray-50 p-5 rounded-2xl border border-gray-100 space-y-2 flex flex-col justify-between">
                <h3 class="font-bold text-gray-900 uppercase tracking-wider mb-2">Payment Details</h3>
                <div class="space-y-1">
                    <div class="flex justify-between text-gray-600">
                        <span>Items Total</span>
                        <span class="font-bold text-gray-900">₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
                    </div>
                    <div class="flex justify-between text-gray-600">
                        <span>Delivery</span>
                        <span class="font-bold text-emerald-600">FREE</span>
                    </div>
                    <div class="flex justify-between text-gray-900 text-sm font-black pt-2 border-t border-gray-200">
                        <span>Total Paid</span>
                        <span class="text-blue-600">₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="pt-4 border-t border-gray-100 flex justify-between">
            <a href="/orders" class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs px-5 py-2.5 rounded-xl transition">
                <i class="fa-solid fa-arrow-left mr-1"></i> Back to Orders
            </a>
            <% if (order.paymentStatus === 'failed') { %>
                <a href="/payment/<%= order._id %>" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow transition">
                    Retry Payment
                </a>
            <% } %>
        </div>

    </div>

</main>

</body>
</html>
