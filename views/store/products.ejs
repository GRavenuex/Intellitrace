<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    
    <!-- Title & Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 pb-6 border-b border-gray-200 gap-4">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Electronics Catalog</h1>
            <p class="text-xs text-gray-500 mt-1">Showing <%= products.length %> items matching your preference</p>
        </div>

        <!-- Sort Control -->
        <form action="/products" method="GET" class="flex items-center gap-3">
            <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>"><% } %>
            <% if (searchQuery) { %><input type="hidden" name="search" value="<%= searchQuery %>"><% } %>
            
            <label for="sort" class="text-xs font-bold text-gray-600 uppercase tracking-wider">Sort By:</label>
            <select name="sort" id="sort" onchange="this.form.submit()" class="bg-white border border-gray-300 text-xs font-semibold rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="newest" <%= selectedSort === 'newest' ? 'selected' : '' %>>Newest Arrivals</option>
                <option value="price-asc" <%= selectedSort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
                <option value="price-desc" <%= selectedSort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
                <option value="rating" <%= selectedSort === 'rating' ? 'selected' : '' %>>Customer Rating</option>
            </select>
        </form>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        
        <!-- Sidebar Filters -->
        <aside class="space-y-6 bg-white p-6 rounded-2xl border border-gray-200 shadow-sm h-fit">
            <form action="/products" method="GET" class="space-y-6">
                <!-- Search Input -->
                <div>
                    <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-3">Search Catalog</h3>
                    <div class="relative">
                        <input type="text" 
                               name="search" 
                               value="<%= searchQuery %>" 
                               placeholder="Keywords..." 
                               class="w-full pl-9 pr-3 py-2 text-xs border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-gray-400 text-xs"></i>
                    </div>
                </div>

                <!-- Category Filter -->
                <div>
                    <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-3">Categories</h3>
                    <div class="space-y-1.5">
                        <a href="/products" class="block text-xs py-1.5 px-3 rounded-lg font-medium <%= !selectedCategory ? 'bg-blue-600 text-white font-bold' : 'text-gray-600 hover:bg-gray-100' %>">
                            All Categories
                        </a>
                        <% categories.forEach(function(cat) { %>
                            <a href="/products?category=<%= cat %>" 
                               class="block text-xs py-1.5 px-3 rounded-lg font-medium <%= selectedCategory === cat ? 'bg-blue-600 text-white font-bold' : 'text-gray-600 hover:bg-gray-100' %>">
                                <%= cat %>
                            </a>
                        <% }); %>
                    </div>
                </div>

                <!-- Price Range Filter -->
                <div>
                    <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-3">Price Range (₹)</h3>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="number" name="minPrice" placeholder="Min" value="<%= minPrice %>" class="w-full text-xs p-2 border border-gray-300 rounded-xl">
                        <input type="number" name="maxPrice" placeholder="Max" value="<%= maxPrice %>" class="w-full text-xs p-2 border border-gray-300 rounded-xl">
                    </div>
                </div>

                <div class="pt-2 flex gap-2">
                    <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold py-2.5 rounded-xl shadow transition">
                        Apply Filters
                    </button>
                    <a href="/products" class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold py-2.5 px-3 rounded-xl transition">
                        Reset
                    </a>
                </div>
            </form>
        </aside>

        <!-- Product Cards Grid -->
        <div class="lg:col-span-3">
            <% if (products.length === 0) { %>
                <div class="bg-white p-12 text-center rounded-2xl border border-gray-200 shadow-sm space-y-3">
                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto text-gray-400 text-2xl">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-800">No Products Found</h3>
                    <p class="text-xs text-gray-500">Try adjusting your search criteria or resetting filters.</p>
                    <a href="/products" class="inline-block bg-blue-600 text-white text-xs font-bold px-4 py-2 rounded-xl mt-2">View All Products</a>
                </div>
            <% } else { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% products.forEach(function(product) { %>
                        <div class="bg-white rounded-2xl border border-gray-200/90 shadow-sm overflow-hidden flex flex-col hover:shadow-xl transition-all duration-300 group">
                            
                            <div class="relative bg-gray-50 p-4 flex items-center justify-center h-48 overflow-hidden">
                                <img src="<%= product.image %>" 
                                     alt="<%= product.name %>" 
                                     class="max-h-full object-contain group-hover:scale-105 transition-transform duration-300">
                                
                                <span class="absolute top-3 right-3 bg-slate-900/80 text-amber-400 text-xs font-bold px-2.5 py-1 rounded-full flex items-center gap-1 backdrop-blur-sm">
                                    <i class="fa-solid fa-star text-[10px]"></i> <%= product.rating %>
                                </span>

                                <% if (product.stock > 0) { %>
                                    <span class="absolute top-3 left-3 bg-emerald-100 text-emerald-700 text-[10px] font-bold px-2 py-0.5 rounded-md">In Stock</span>
                                <% } else { %>
                                    <span class="absolute top-3 left-3 bg-red-100 text-red-700 text-[10px] font-bold px-2 py-0.5 rounded-md">Out of Stock</span>
                                <% } %>
                            </div>

                            <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
                                <div>
                                    <div class="flex items-center justify-between text-[11px] mb-1">
                                        <span class="font-bold text-blue-600 uppercase tracking-wider"><%= product.category %></span>
                                        <span class="text-gray-400"><%= product.brand %></span>
                                    </div>
                                    <h3 class="font-bold text-gray-900 text-base line-clamp-1 group-hover:text-blue-600 transition">
                                        <a href="/products/<%= product._id %>"><%= product.name %></a>
                                    </h3>
                                    <p class="text-xs text-gray-500 line-clamp-2 mt-1"><%= product.description %></p>
                                </div>

                                <div class="pt-3 border-t border-gray-100 space-y-3">
                                    <div class="flex items-center justify-between">
                                        <span class="text-lg font-extrabold text-gray-900">₹<%= product.price.toLocaleString('en-IN') %></span>
                                    </div>

                                    <div class="grid grid-cols-2 gap-2">
                                        <a href="/products/<%= product._id %>" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold py-2 rounded-xl text-center transition">
                                            View Details
                                        </a>
                                        
                                        <form action="/cart/add" method="POST">
                                            <input type="hidden" name="productId" value="<%= product._id %>">
                                            <input type="hidden" name="quantity" value="1">
                                            <button type="submit" 
                                                    <%= product.stock === 0 ? 'disabled' : '' %>
                                                    class="w-full bg-blue-600 hover:bg-blue-700 disabled:bg-gray-300 text-white text-xs font-bold py-2 rounded-xl text-center shadow transition flex items-center justify-center gap-1">
                                                <i class="fa-solid fa-cart-plus"></i> Add
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>

                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>

    </div>
</main>

</body>
</html>
