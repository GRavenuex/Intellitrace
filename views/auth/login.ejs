<%- include('../partials/head.ejs') %>
<%- include('../partials/nav.ejs') %>

<main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-xl border border-gray-100">
        
        <div class="text-center mb-8">
            <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center mx-auto mb-3 text-xl">
                <i class="fa-solid fa-right-to-bracket"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-900">Welcome Back to IntelliShop</h2>
            <p class="text-xs text-gray-500 mt-1">Sign in to manage orders and explore top technology deals</p>
        </div>

        <%- include('../partials/errors.ejs') %>

        <form action="/login" method="POST" class="space-y-5">
            <div>
                <label for="email" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">Email Address</label>
                <div class="relative">
                    <input type="email" 
                           id="email" 
                           name="email" 
                           value="<%= oldInput ? oldInput.email : '' %>"
                           required 
                           placeholder="customer@intellishop.com" 
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                </div>
            </div>

            <div>
                <label for="password" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">Password</label>
                <div class="relative">
                    <input type="password" 
                           id="password" 
                           name="password" 
                           required 
                           placeholder="••••••••" 
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                </div>
            </div>

            <button type="submit" 
                    class="w-full py-3 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold text-sm rounded-xl shadow-md transition transform active:scale-95">
                Sign In
            </button>
        </form>

        <div class="mt-6 pt-6 border-t border-gray-100 text-center">
            <p class="text-xs text-gray-600">
                Don't have an account? 
                <a href="/signup" class="text-blue-600 font-semibold hover:underline">Create an Account</a>
            </p>
        </div>

        <div class="mt-6 bg-slate-50 p-4 rounded-xl text-[11px] text-gray-600 space-y-1">
            <p class="font-bold text-gray-700">Quick Test Credentials:</p>
            <p><span class="font-semibold text-gray-800">Customer:</span> customer@intellishop.com / Customer@123</p>
            <p><span class="font-semibold text-gray-800">Admin:</span> admin@intellishop.com / Admin@123</p>
        </div>

    </div>
</main>

</body>
</html>